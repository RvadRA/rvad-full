                        {notif.orderId && <p className={`text-[9px] font-mono mt-1 opacity-50 ${t.mutedTextClass}`}>ID: {notif.orderId}</p>}
                      </div>
                    </div>
                  </div>
                ))
              )}
            </div>
            {notifications.length > 0 && (
              <div className="p-3 border-t border-black/5 text-center">
                 <button 
